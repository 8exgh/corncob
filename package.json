{
  "name": "corncob-3d-web",
  "version": "0.1.0",
  "private": true,
  "description": "Archival WebAssembly edition of Corncob 3D 3.42",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build": "vite build && tsc --outDir server-dist --noEmit false",
    "start": "node server-dist/server.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "js-dos": "^8.3.20",
    "ws": "^8.21.3"
  }
}
